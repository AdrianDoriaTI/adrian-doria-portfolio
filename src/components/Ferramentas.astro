---
import Icon from './Icon.astro';
import { ferramentas } from '../data/perfil';
import { logos } from '../data/logos';
---
<section aria-label="Ferramentas" class="mx-auto max-w-6xl px-5 pb-20 md:px-8 md:pb-24">
  <ul class="grid grid-cols-3 gap-3 sm:grid-cols-6 md:gap-4">
    {ferramentas.map((f) => (
      <li class="tool flex flex-col items-center gap-2.5 rounded-2xl border border-line bg-surface px-2 py-4 md:py-5">
        {'logo' in f ? (
          <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" set:html={logos[f.logo]} />
        ) : (
          <span class="text-accent-ink"><Icon name={f.icone} size={32} /></span>
        )}
        <span class="text-sm font-medium">{f.nome}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .tool {
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s ease, border-color 0.3s ease;
  }
  @media (hover: hover) {
    .tool:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: color-mix(in oklch, var(--accent) 60%, var(--line)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tool:hover { transform: none; }
  }
</style>
