---
import { experiencias, formacao, certificacoes } from '../data/perfil';
---
<section id="experiencia" class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
  <div class="grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-20">
    <div>
      <h2 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold">Onde aprendi o negócio</h2>

      <ol class="mt-10 border-t border-line">
        {experiencias.map((xp) => (
          <li class="xp grid gap-1 border-b border-line py-6 md:grid-cols-[11rem_1fr] md:gap-8">
            <p class="text-sm font-medium text-accent-ink md:pt-1.5">{xp.empresa}</p>
            <div>
              <h3 class="text-xl font-semibold tracking-tight">{xp.cargo}</h3>
              <p class="mt-1.5 max-w-[60ch] text-muted">{xp.resumo}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <aside class="flex flex-col gap-10 lg:pt-3">
      <div>
        <h2 class="text-xl font-semibold">Formação</h2>
        <p class="mt-3 font-medium">{formacao.curso}</p>
        <p class="text-sm text-muted">{formacao.instituicao} · <span class="tabular-nums">{formacao.periodo}</span></p>
      </div>
      <div>
        <h2 class="text-xl font-semibold">Certificações <span class="font-normal text-muted">· {certificacoes.emissor}</span></h2>
        <ul class="mt-3 flex flex-col gap-2">
          {certificacoes.itens.map((c) => (
            <li class="flex gap-3 text-[0.9375rem]">
              <span class="mt-[0.6em] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
              {c}
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .xp { transition: background-color 0.25s ease; }
  @media (hover: hover) {
    .xp:hover { background: linear-gradient(90deg, var(--accent-soft), transparent 70%); }
  }
</style>
