---
import { sobre } from '../data/perfil';
---
<section id="sobre" class="mx-auto max-w-6xl px-5 pb-20 md:px-8 md:pb-28">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold">{sobre.titulo}</h2>

      <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-line pt-6 lg:grid-cols-1 lg:gap-6">
        {sobre.numeros.map((n) => (
          <div class="flex flex-col gap-1 lg:flex-row lg:items-baseline lg:gap-4">
            <dt class="order-2 text-sm leading-snug text-muted">{n.rotulo}</dt>
            <dd class="order-1 font-display text-[clamp(2.25rem,6vw,3.5rem)] leading-none font-semibold tracking-tight tabular-nums lg:min-w-[4.5rem]">
              <span data-count={n.valor}>{n.valor}</span><span class="text-accent-ink">{n.sufixo}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="flex flex-col gap-8 md:gap-10">
      {sobre.paragrafos.map((p, i) => (
        <p
          class:list={['story font-display text-[clamp(1.3rem,2.6vw,1.75rem)] leading-[1.35] font-medium tracking-tight', { 'story--fim': i === sobre.paragrafos.length - 1 }]}
          data-reveal
        >{p}</p>
      ))}
      <a href="#projetos" class="group inline-flex items-center gap-2 self-start font-medium text-accent-ink underline-offset-4 hover:underline">
        Ver os projetos
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Leitura guiada: cada parágrafo "acende" ao entrar na tela. Sem JS ou com movimento reduzido, fica tudo em --ink. */
  :global(.js) .story {
    color: var(--muted);
    opacity: 0.55;
    transition: color 0.9s var(--ease-out-expo), opacity 0.9s var(--ease-out-expo);
  }
  :global(.js) .story.is-in { color: var(--ink); opacity: 1; }
  .story--fim { padding-left: 1.25rem; border-left: 2px solid var(--accent); }
</style>
