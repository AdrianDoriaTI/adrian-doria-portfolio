---
// Painel: o portfólio em formato de dashboard. Só dados reais do perfil, sem valores fictícios.
import Icon from './Icon.astro';
import { fluxo, projetos, ferramentas, experiencias, formacao, certificacoes, estudando } from '../data/perfil';
import { logos } from '../data/logos';

// Períodos do currículo (meses só para o KPI de anos de experiência).
const periodos: Record<string, { periodo: string; meses: number }> = {
  'Cencosud S.A.': { periodo: 'Dez/2023 a Mai/2026', meses: 29 },
  'Stefanini Group': { periodo: 'Ago/2022 a Dez/2023', meses: 16 },
  'Randstad Brasil': { periodo: 'Nov/2021 a Ago/2022', meses: 9 },
};
const totalMeses = Object.values(periodos).reduce((s, p) => s + p.meses, 0);
const totalItens = fluxo.reduce((s, f) => s + f.itens.length, 0);
const projetosNoAr = projetos.filter((p) => p.status !== 'Projeto pessoal').length;

const kpis = [
  { valor: (totalMeses / 12).toFixed(1).replace('.', ','), rotulo: 'anos em administrativo e financeiro' },
  { valor: String(experiencias.length), rotulo: 'empresas de grande porte' },
  { valor: String(projetosNoAr), rotulo: 'projetos no ar' },
  { valor: String(totalItens), rotulo: 'conhecimentos em 3 áreas' },
  { valor: 'ADS', rotulo: `formação concluída, ${formacao.periodo.split('–')[1].trim()}` },
];
---
<section id="painel" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
    <div class="max-w-2xl">
      <h2 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold">Meu portfólio em formato de painel</h2>
      <p class="mt-4 text-muted">Dashboard é o que eu fazia no trabalho. Aqui ele conta a minha história, só com números reais do meu currículo.</p>
    </div>

    <div class="painel mt-10 md:mt-14" data-painel>
      <div class="barra">
        <span class="inline-flex items-center gap-2 font-medium"><Icon name="dashboard" size={16} /> Painel · Adrian Doria</span>
        <span class="filtros" aria-hidden="true">
          <span class="filtro">Período: 2021 a 2026</span>
          <span class="filtro">Visão: carreira</span>
        </span>
      </div>

      <ul class="kpis" aria-label="Indicadores">
        {kpis.map((k) => (
          <li class="kpi">
            <p class="kpi-valor">{k.valor}</p>
            <p class="kpi-rotulo">{k.rotulo}</p>
          </li>
        ))}
      </ul>

      <div class="grade">
        <section class="card" aria-label="Últimas empresas">
          <h3 class="card-titulo">Últimas empresas</h3>
          <ol class="empresas">
            {experiencias.map((xp) => (
              <li>
                <span class="ponto" aria-hidden="true"></span>
                <p class="emp-nome">{xp.empresa}</p>
                <p class="emp-cargo">{xp.cargo} <span class="muted">· {periodos[xp.empresa]?.periodo}</span></p>
                <p class="sub">{xp.resumo}</p>
              </li>
            ))}
          </ol>
        </section>

        <section class="card card--2" aria-label="Conhecimentos por área">
          <h3 class="card-titulo">Conhecimentos por área</h3>
          <div class="slicer" role="group" aria-label="Filtrar por área">
            {fluxo.map((f, i) => (
              <button type="button" class="slice" data-area={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                <Icon name={f.icone} size={15} /> {f.titulo}
              </button>
            ))}
          </div>
          {fluxo.map((f, i) => (
            <ul class="itens" data-lista={f.id} hidden={i !== 0}>
              {f.itens.map((item) => (
                <li class="item">
                  <span class="item-icone">
                    {'logo' in item ? (
                      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={logos[item.logo]} />
                    ) : (
                      <Icon name={item.icone} size={20} />
                    )}
                  </span>
                  <div>
                    <p class="item-nome">{item.nome}</p>
                    <p class="sub">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          ))}
        </section>

        <section class="card" aria-label="Ferramentas">
          <h3 class="card-titulo">Ferramentas</h3>
          <ul class="ferr">
            {ferramentas.map((f) => (
              <li>
                {'logo' in f ? (
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={logos[f.logo]} />
                ) : (
                  <span class="text-accent-ink"><Icon name={f.icone} size={22} /></span>
                )}
                <span>{f.nome}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="card card--2" aria-label="Projetos">
          <h3 class="card-titulo">Projetos</h3>
          <table class="tabela">
            <thead><tr><th>Projeto</th><th>Ferramentas</th><th>Status</th></tr></thead>
            <tbody>
              {projetos.map((p) => (
                <tr>
                  <td class="font-medium">{p.nome}</td>
                  <td>{p.tags.filter((t) => t !== 'Criado com Claude Code').join(' · ')}</td>
                  <td><span class="selo">{p.status}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section class="card card--2" aria-label="Estudando atualmente">
          <h3 class="card-titulo">Estudando atualmente</h3>
          <ul class="estudo">
            {estudando.foco.map((e) => (
              <li>
                {'logo' in e ? (
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={logos[e.logo]} />
                ) : (
                  <span class="text-accent-ink"><Icon name={e.icone} size={18} /></span>
                )}
                <span>{e.nome}</span>
              </li>
            ))}
          </ul>
          <p class="sub mt-4">{estudando.linguagens}</p>
        </section>

        <section class="card" aria-label="Formação">
          <h3 class="card-titulo">Formação</h3>
          <p class="item-nome">{formacao.curso}</p>
          <p class="sub">{formacao.instituicao} · {formacao.periodo}</p>
          <p class="sub mt-4">Cursos {certificacoes.emissor}, em sua maioria de análise financeira, Power BI e dashboards:</p>
          <ul class="cursos">
            {certificacoes.itens.map((c) => <li>{c}</li>)}
          </ul>
        </section>
      </div>

      <p class="alerta"><Icon name="check" size={14} /> Alerta do painel: este portfólio está dentro do orçamento e sem pendências. 😄</p>
    </div>
  </div>
</section>

<style>
  .painel { border: 1px solid var(--line); border-radius: 1.25rem; background: var(--surface); overflow: hidden; }
  .barra { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; padding: 0.9rem 1.25rem; border-bottom: 1px solid var(--line); background: var(--paper); font-size: 0.9rem; }
  .filtros { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .filtro { padding: 0.2rem 0.65rem; border: 1px solid var(--line); border-radius: 999px; font-size: 0.8rem; color: var(--muted); background: var(--surface); }

  .kpis { display: grid; grid-template-columns: repeat(2, 1fr); list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .kpis { grid-template-columns: repeat(5, 1fr); } }
  .kpi { padding: 1.1rem 1.25rem; border-right: 1px solid var(--line); border-top: 1px solid var(--line); }
  .kpi:first-child, .kpi:nth-child(2) { border-top: 0; }
  @media (min-width: 900px) { .kpi { border-top: 0; } }
  .kpi-valor { font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 600; color: var(--accent-ink); line-height: 1.1; }
  .kpi-rotulo { margin-top: 0.25rem; font-size: 0.82rem; color: var(--muted); }

  .grade { display: grid; gap: 1px; background: var(--line); }
  @media (min-width: 900px) { .grade { grid-template-columns: repeat(3, 1fr); } .card--2 { grid-column: span 2; } }
  .card { margin: 0; padding: 1.25rem; background: var(--surface); min-width: 0; }
  .card-titulo { font-weight: 600; margin-bottom: 1rem; font-size: 1rem; }
  .muted, .sub { color: var(--muted); }
  .sub { font-size: 0.82rem; line-height: 1.45; margin-top: 0.15rem; }

  /* Empresas */
  .empresas { list-style: none; margin: 0; padding: 0 0 0 1rem; border-left: 2px solid var(--accent-soft); display: grid; gap: 1.1rem; }
  .empresas li { position: relative; }
  .ponto { position: absolute; left: -1.38rem; top: 0.35rem; width: 0.6rem; height: 0.6rem; border-radius: 999px; background: var(--accent); }
  .emp-nome { font-weight: 600; }
  .emp-cargo { font-size: 0.88rem; }

  /* Slicer + itens */
  .slicer { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .slice { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.85rem; border: 1px solid var(--line); border-radius: 999px; background: var(--paper); font-size: 0.85rem; cursor: pointer; color: inherit; transition: background 0.2s, border-color 0.2s; }
  .slice:hover { border-color: var(--accent); }
  .slice[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 600; }
  .itens { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  @media (min-width: 640px) { .itens { grid-template-columns: 1fr 1fr; } }
  .itens[hidden] { display: none; }
  .item { display: flex; gap: 0.75rem; padding: 0.8rem; border: 1px solid var(--line); border-radius: 0.9rem; background: var(--paper); }
  .item-icone { flex: none; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 0.6rem; background: var(--accent-soft); color: var(--accent-ink); }
  .item-nome { font-weight: 600; font-size: 0.92rem; }

  /* Ferramentas */
  .ferr { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .ferr li { display: flex; align-items: center; gap: 0.55rem; padding: 0.55rem 0.7rem; border: 1px solid var(--line); border-radius: 0.8rem; background: var(--paper); font-size: 0.88rem; }

  /* Projetos */
  .tabela { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .tabela th { text-align: left; color: var(--muted); font-weight: 500; padding-bottom: 0.5rem; }
  .tabela td { padding: 0.6rem 0.5rem 0.6rem 0; border-top: 1px solid var(--line); vertical-align: top; }
  .selo { white-space: nowrap; padding: 0.15rem 0.6rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent-ink); font-size: 0.78rem; }

  .estudo { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  @media (min-width: 640px) { .estudo { grid-template-columns: repeat(3, 1fr); } }
  .estudo li { display: flex; align-items: center; gap: 0.55rem; padding: 0.55rem 0.7rem; border: 1px solid var(--line); border-radius: 0.8rem; background: var(--paper); font-size: 0.88rem; }
  .cursos { margin: 0.5rem 0 0; padding-left: 1.1rem; font-size: 0.85rem; display: grid; gap: 0.25rem; }
  .alerta { display: flex; align-items: center; gap: 0.5rem; padding: 0.9rem 1.25rem; border-top: 1px solid var(--line); background: var(--paper); font-size: 0.85rem; color: var(--muted); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-painel]').forEach((painel) => {
    const botoes = painel.querySelectorAll<HTMLButtonElement>('.slice');
    const listas = painel.querySelectorAll<HTMLElement>('[data-lista]');
    botoes.forEach((b) => {
      b.addEventListener('click', () => {
        botoes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        listas.forEach((l) => { l.hidden = l.dataset.lista !== b.dataset.area; });
      });
    });
  });
</script>
