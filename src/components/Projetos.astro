---
import Icon from './Icon.astro';
import { perfil } from '../data/perfil';
---
<section id="projetos" class="border-t border-line bg-surface">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-20 md:flex-row md:items-end md:justify-between md:px-8 md:py-24">
    <div class="max-w-xl">
      <h2 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold">Projetos</h2>
      <p class="mt-4 text-muted">[PLACEHOLDER] Automações, agentes e dashboards em destaque entram aqui. Enquanto isso, o código está no GitHub.</p>
    </div>
    <a
      href={perfil.github}
      target="_blank"
      rel="noopener"
      class="group inline-flex shrink-0 items-center gap-3 self-start rounded-full border border-line px-5 py-3 font-medium transition-colors hover:border-ink md:self-auto"
    >
      <Icon name="github" size={18} /> github.com/AdrianDoriaTI
      <Icon name="arrow" size={16} class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </a>
  </div>
</section>
