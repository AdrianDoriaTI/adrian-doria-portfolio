---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Ferramentas from '../components/Ferramentas.astro';
import Fluxo from '../components/Fluxo.astro';
import Experiencia from '../components/Experiencia.astro';
import Projetos from '../components/Projetos.astro';
import Contato from '../components/Contato.astro';
---
<Base
  title="Adrian Doria · Administrativo, Financeiro e Automação"
  description="Analista administrativo e financeiro com mais de 4 anos de experiência, construindo automações e sistemas com dados e IA. Veja os projetos funcionando."
>
  <Header />
  <main id="conteudo">
    <Hero />
    <Ferramentas />
    <Sobre />
    <Fluxo />
    <Experiencia />
    <Projetos />
    <Contato />
  </main>
</Base>
